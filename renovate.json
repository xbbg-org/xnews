{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "enabledManagers": ["npm", "github-actions"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group development tooling updates into a single PR.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "js tooling"
    },
    {
      "description": "Keep the companion's LangChain, LangGraph, and Zod compatibility set together.",
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/xnews-langgraph/package.json"],
      "matchPackageNames": ["@langchain/**", "langchain", "zod"],
      "groupName": "langgraph compatibility"
    },
    {
      "description": "Group GitHub Actions updates into a single PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
